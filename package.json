{
  "name": "virtual-building-studio-main",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "npm run fetch:sanity-resources && next build",
    "fetch:sanity-resources": "node scripts/fetch-sanity-resources-snapshot.mjs",
    "studio": "npm run dev --prefix studio-vbs",
    "studio:build": "npm run build --prefix studio-vbs",
    "studio:deploy": "npm run deploy --prefix studio-vbs",
    "start": "next start",
    "lint": "eslint",
    "clean": "node -e \"const fs=require('fs');['.next','node_modules/.cache'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch(e){}})\""
  },
  "dependencies": {
    "@portabletext/react": "^4.0.3",
    "@sanity/client": "^7.23.0",
    "@sanity/image-url": "^1.2.0",
    "bootstrap": "^5.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.6",
    "swiper": "^14.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "latest",
    "postcss": "^8.5.6",
    "sass": "^1.101.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
